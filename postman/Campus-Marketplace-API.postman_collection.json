    {
      "name": "Listings",
      "item": [
        {
          "name": "Create Listing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created listing', () => pm.response.to.have.status(201));",
                  "const listing = pm.response.json().listing;",
                  "pm.test('Defaults and fields look right', () => {",
                  "  pm.expect(listing.title).to.eql('Used calculus textbook');",
                  "  pm.expect(listing.price).to.eql(35);",
                  "  pm.expect(listing.category).to.eql('textbooks');",
                  "  pm.expect(listing.condition).to.eql('used');",
                  "  pm.expect(listing.status).to.eql('active');",
                  "  pm.expect(listing.seller).to.eql(pm.collectionVariables.get('userId'));",
                  "});",
                  "pm.collectionVariables.set('listingId', listing.id);",
                  "pm.collectionVariables.set('soldListingId', listing.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Used calculus textbook\",\n  \"description\": \"Stewart Calculus, 8th edition\",\n  \"price\": 35,\n  \"category\": \"textbooks\",\n  \"condition\": \"used\",\n  \"seller\": \"{{userId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/listings"
          }
        },
        {
          "name": "Get All Listings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Listed listings', () => pm.response.to.have.status(200));",
                  "const listings = pm.response.json().listings;",
                  "pm.test('listings is an array', () => pm.expect(listings).to.be.an('array'));",
                  "pm.test('Removed listings are hidden by default', () => {",
                  "  listings.forEach((l) => pm.expect(l.status).to.not.eql('removed'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/listings"
          }
        },
        {
          "name": "Get Listing",
          "event": [
            {
              "listen": "test",
