              "mode": "raw",
              "raw": "{\n  \"title\": \"Old desk chair\",\n  \"description\": \"Will be soft-deleted\",\n  \"price\": 15,\n  \"category\": \"furniture\",\n  \"condition\": \"worn\",\n  \"seller\": \"{{userId}}\"\n}"
