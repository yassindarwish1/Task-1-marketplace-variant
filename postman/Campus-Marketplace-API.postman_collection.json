    {
      "name": "Users",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('userEmail', `alex.${Date.now()}@campus.edu`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created user', () => pm.response.to.have.status(201));",
                  "const user = pm.response.json().user;",
                  "pm.test('User has id, name, email (no password)', () => {",
                  "  pm.expect(user).to.have.property('id');",
                  "  pm.expect(user).to.have.property('name', 'Alex Chen');",
                  "  pm.expect(user).to.have.property('email', pm.collectionVariables.get('userEmail'));",
                  "  pm.expect(user).to.not.have.property('password');",
                  "});",
                  "pm.collectionVariables.set('userId', user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Chen\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"secret12\"\n}"
            },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Get All Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Listed users', () => pm.response.to.have.status(200));",
                  "pm.test('users is an array', () => pm.expect(pm.response.json().users).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Get User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Got user', () => pm.response.to.have.status(200));",
                  "pm.test('Matches saved id', () => {",
                  "  pm.expect(pm.response.json().user.id).to.eql(pm.collectionVariables.get('userId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
